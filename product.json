16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"\/><\/svg>\n  <span id=\"wishlist-text-{{ product.id }}\">Add to Wishlist<\/span>\n<\/button>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  let wishlist = JSON.parse(localStorage.getItem('luxewear_wishlist')) || [];\n  const btn = document.getElementById('wishlist-btn-{{ product.id }}');\n  const txt = document.getElementById('wishlist-text-{{ product.id }}');\n  if(btn && wishlist.includes('{{ product.id }}')) {\n    btn.classList.add('active');\n    txt.innerText = \"In Your Wishlist\";\n  }\n});\n\nfunction toggleWishlist(id) {\n  let wishlist = JSON.parse(localStorage.getItem('luxewear_wishlist')) || [];\n  const btn = document.getElementById('wishlist-btn-' + id);\n  const txt = document.getElementById('wishlist-text-' + id);\n  \n  if(wishlist.includes(id)) {\n    wishlist = wishlist.filter(item => item !== id);\n    btn.classList.remove('active');\n    txt.innerText = \"Add to Wishlist\";\n  } else {\n    wishlist.push(id);\n    btn.classList.add('active');\n    txt.innerText = \"In Your Wishlist\";\n  }\n  localStorage.setItem('luxewear_wishlist', JSON.stringify(wishlist));\n}\n<\/script>"}},"description":{"type":"description","settings":{}},"share":{"type":"share","disabled":true,"settings":{"share_label":"Share"}}},"block_order":["collapsible_tab_bNLaYT","custom_liquid_G7Pfmr","title","vendor","variant_picker","quantity_selector","price","buy_buttons","custom_liquid_iepiHH","description","share"],"settings":{"enable_sticky_info":true,"media_size":"large","constrain_to_viewport":true,"media_fit":"contain","gallery_layout":"stacked","media_position":"left","image_zoom":"none","mobile_thumbnails":"hide","hide_variants":true,"enable_video_looping":false,"padding_top":64,"padding_bottom":0}},"related-products":{"type":"related-products","settings":{"heading":"Related products","heading_size":"h2","products_to_show":4,"columns_desktop":4,"color_scheme":"background-